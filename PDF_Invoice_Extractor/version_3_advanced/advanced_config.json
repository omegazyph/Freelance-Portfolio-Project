{
    "author": "omegazyph",
    "version_type": "Advanced_GUI_Suite",
    "header_name" : "PDF Data Automation Suite",
    "extraction_patterns": {
        "date_patterns": [
            "(\\d{1,4}[-/]\\d{1,2}[-/]\\d{2,4})",
            "((?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},\\s+\\d{4})",
            "(\\d{1,2}\\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{4})"
        ],
        "amount_patterns": [
            "\\$(\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2}))",
            "Total:\\s*(\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2}))",
            "Amount\\s*Due:\\s*\\$?(\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2}))"
        ]
    },
    "last_input_folder": "C:/Invoices/Input",
    "last_output_folder": "C:/Invoices/Output",
    "ui_theme": "clam",
    "header_color": "#1a73e8",
    "window_geometry": "700x750",
    "auto_open_report": true
}